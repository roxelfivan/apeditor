{
  "name": "apeditor",
  "private": true,
  "version": "0.5.8",
  "type": "module",
  "description": "Minimal local-first AI markdown editor (MVP).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/sync-ocr-runtime-assets.mjs",
    "prebuild": "node scripts/sync-ocr-runtime-assets.mjs",
    "sync:ocr-assets": "node scripts/sync-ocr-runtime-assets.mjs",
    "typecheck": "tsc -b --noEmit",
    "test:heading-sections": "node scripts/test-heading-sections.mjs",
    "test:proposed-edit": "node scripts/test-proposed-edit.mjs",
    "test:graph": "node scripts/test-graph.mjs",
    "test:backup-roundtrip": "node scripts/test-backup-roundtrip.mjs",
    "check:docs": "node scripts/check-func-spec-links.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.13",
    "@fontsource/newsreader": "^5.0.14",
    "@fontsource/source-sans-3": "^5.0.13",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "diff": "^5.2.0",
    "onnxruntime-web": "^1.30.0",
    "pdfjs-dist": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "three": "^0.160.1",
    "uuid": "^9.0.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
