# First-run defaults — the in-app Settings modal always wins afterwards.
# - VITE_DEFAULT_PROVIDER: local-gemma (default), minimax, openai, ollama, or lm-studio
# - VITE_DEFAULT_API_ENDPOINT: HTTP providers — full URL or base
#   (the app appends /chat/completions when needed)
# - VITE_DEFAULT_MODEL: HTTP model id (ignored for local-gemma)
VITE_DEFAULT_PROVIDER=local-gemma
VITE_DEFAULT_API_ENDPOINT=https://api.minimax.io/v1
VITE_DEFAULT_MODEL=MiniMax-M2.7
